# Payload CMS. Copy to .env.local. Never commit real values.
PAYLOAD_SECRET=
PREVIEW_SECRET=
# Neon pooled connection string (*-pooler.*). Required before /admin or cms:import.
DATABASE_URL=
# Public https origin. On Vercel this must never be localhost.
NEXT_PUBLIC_SERVER_URL=https://houstoncoolpools.com
NEXT_PUBLIC_SITE_URL=https://houstoncoolpools.com
# Enables Vercel Blob uploads for Media. Without it, /media 404s in production.
BLOB_READ_WRITE_TOKEN=
# First admin user for `npm run cms:create-user`.
CMS_USER_EMAIL=
CMS_USER_PASSWORD=
